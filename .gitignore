# Terraform
.terraform/
.terraform.lock.hcl
# But keep lock files for root modules (environments) tracked
!foundation/terraform/environments/**/.terraform.lock.hcl
!platform/terraform/environments/**/.terraform.lock.hcl
!workload/terraform/environments/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
*.tfvars
!*.tfvars.example
terraform.tfplan
.terraformrc
terraform.rc

# Environment files
.env
.env.*
!.env.example

# IDE
.idea/
*.swp
*.swo
*~
.DS_Store
._*

# Scripts
service-principals.env

# Logs
*.log

# SSH keys
*.pem
*.key
id_rsa*
!id_rsa*.pub

# Backup files
*.bak
*.backup

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
env/

# Node
node_modules/
package-lock.json

# Cursor IDE
# Ignore everything in .cursor/ except rules/ and commands/ directories and their contents
.cursor/*
!.cursor/rules/
!.cursor/commands/

# VSCode IDE
# Ignore everything in .vscode/ except tasks.json
.vscode/*
!.vscode/tasks.json
