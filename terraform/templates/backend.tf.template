# Backend Configuration Template
#
# This template documents the backend configuration pattern used across all environments.
# Copy this file to <environment>/backend.tf and update the environment-specific values.
#
# Note: Terraform backend blocks cannot use variables or locals - they must contain literal values.
# This is a Terraform limitation, so we standardize the structure and use comments to indicate
# which values need to be changed per environment.

terraform {
  backend "azurerm" {
    # Environment-specific configuration
    # Update these values when setting up a new environment:
    # - resource_group_name:  rg-ecare-{env}
    # - storage_account_name: tfstatehycomecare{env}
    # - container_name:       tfstate (same for all environments)
    # - key:                  infra-platform/terraform.tfstate (same for all environments)
    # - use_azuread_auth:     true (same for all environments)
    resource_group_name  = "rg-ecare-{env}"           # CHANGE: Replace {env} with environment name
    storage_account_name = "tfstatehycomecare{env}"   # CHANGE: Replace {env} with environment name
    container_name       = "tfstate"
    key                  = "infra-platform/terraform.tfstate"
    use_azuread_auth     = true
  }
}

# Example for 'dev' environment:
# resource_group_name  = "rg-ecare-dev"
# storage_account_name = "tfstatehycomecaredev"

# Example for 'prod' environment:
# resource_group_name  = "rg-ecare-prod"
# storage_account_name = "tfstatehycomecareprod"
